import re


currency_regex = r"₹\d{1,3}(?:,\d{2,3})*(?:\.\d{2})?"


sample_content = """The notebook costs ₹500.
The laptop costs ₹45,000.
The pen costs ₹99.50.
The bag costs ₹1,250."""

with open("prices.txt", "w", encoding="utf-8") as file:
    file.write(sample_content)


try:
    with open("prices.txt", "r", encoding="utf-8") as file:
        text_content = file.read()


    monetary_values = re.findall(currency_regex, text_content)


    print("Monetary Values Found:")
    for value in monetary_values:
        print(value)

except FileNotFoundError:
    print("Error: The file 'prices.txt' was not found.")
